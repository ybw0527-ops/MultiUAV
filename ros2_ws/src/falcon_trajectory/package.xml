<?xml version="1.0"?>
<package format="3">
  <name>falcon_trajectory</name>
  <version>0.1.0</version>
  <description>Native ROS 2 Humble port of FALCON B-spline and polynomial trajectory generation.</description>

  <maintainer email="noreply@example.com">FALCON ROS 2 port maintainers</maintainer>
  <license>LicenseRef-FALCON-Upstream</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>falcon_voxel_mapping</depend>
  <depend>geometry_msgs</depend>
  <depend>libnlopt-cxx-dev</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
