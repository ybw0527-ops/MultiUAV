  <version>0.1.0</version>
  <description>Native ROS 2 CPU point-cloud and triangle-mesh depth rendering baseline.</description>
  <maintainer email="noreply@example.com">FALCON ROS 2 port maintainers</maintainer>
  <license>LicenseRef-FALCON-Upstream</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libassimp-dev</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
