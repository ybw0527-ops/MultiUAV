  <version>0.1.0</version>
  <description>ROS 2 exploration planning and state machine.</description>
  <maintainer email="noreply@example.com">FALCON ROS 2 port maintainers</maintainer>
  <license>LicenseRef-FALCON-Upstream</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>falcon_exploration_preprocessing</depend>
  <depend>falcon_fast_planner</depend>
  <depend>falcon_interfaces</depend>
  <depend>falcon_trajectory</depend>
